/**
 * Finds decor objects (lamps, benches, plants) that squeeze a walkway down to one tile between themselves and
 * something else solid, the places where you get stuck with the touch stick. They become walk-through
 * (still drawn): writes src/content/flow.gen.ts, applied in maps.ts. Run: npx vite-node tools/find_squeezes.mts
 */
import { MAPS, BLOCKING } from '../src/content/maps';
import { FLOW_GEN } from '../src/content/flow.gen';
const res: Record<string, string[]> = {};
for (const m of Object.values(MAPS)) {
  if (m.interior || !m.image) continue;
  const H = m.tiles.length, W = m.tiles[0].length;
  const owner: (any | null)[][] = m.tiles.map((r) => [...r].map(() => null));
  const blocked = (x: number, y: number) => x < 0 || y < 0 || x >= W || y >= H || BLOCKING.has(m.tiles[y][x]) || !!owner[y][x];
  for (const o of m.objects) if ((o.solid !== false || FLOW_GEN[m.id]?.includes(o.id)) && (o.w ?? 1) > 0 && !o.when) for (let y = o.y; y < o.y + (o.h ?? 1); y++) for (let x = o.x; x < o.x + (o.w ?? 1); x++) if (y < H && x < W) owner[y][x] = o;
  const bad = new Set<string>();
  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
    if (blocked(x, y)) continue;
    // a 1-tile squeeze: blocked left and right (or up and down), and one of the two sides is a decor object
    for (const [ax, ay, bx, by] of [[x - 1, y, x + 1, y], [x, y - 1, x, y + 1]]) {
      if (blocked(ax, ay) && blocked(bx, by)) {
        const oa = owner[ay]?.[ax], ob = owner[by]?.[bx];
        const culprit = [oa, ob].find((o) => o?.decor && !String(o.id).includes('_edge'));
        // only a squeeze if it is open along the other axis (a passage, not a dead-end pocket)
        const along = ax === bx ? [[x - 1, y], [x + 1, y]] : [[x, y - 1], [x, y + 1]];
        if (culprit && along.every(([px, py]) => !blocked(px, py))) bad.add(culprit.id);
      }
    }
  }
  if (bad.size) res[m.id] = [...bad];
}
for (const [k, v] of Object.entries(res)) console.log(k.padEnd(14), v.length);
import { writeFileSync } from 'node:fs';
writeFileSync(new URL('../src/content/flow.gen.ts', import.meta.url), '/* generated by tools/find_squeezes.mts — do not edit */\n/** decor that would squeeze a walkway to one tile: drawn, but walk-through */\nexport const FLOW_GEN: Record<string, string[]> = ' + JSON.stringify(res) + ';\n');
